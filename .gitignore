############################
# Project generated outputs
############################
# Main generated folders (your repo big stuff)
data/
out/

# Logs (if any get written outside data/)
*.log
logs/

# Optional: caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

############################
# Parquet files (in case any appear outside data/)
############################
*.parquet

############################
# CSV handling (IMPORTANT)
############################
# DO NOT ignore all CSV globally (so you can still commit templates/examples under docs/ or samples/)
# But ignore CSV generated under data/ and out/ (even if you later stop ignoring the whole folder)
data/**/*.csv
out/**/*.csv
