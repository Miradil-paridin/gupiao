# ============================================================
# A股量化系统 - 完整环境变量配置
# ============================================================

# ===== LLM 提供商选择 =====
# 可选值: deepseek / mimo
# 切换这个值即可切换模型，无需修改代码
LLM_PROVIDER=mimo

# ============================================================
# DeepSeek 配置
# ============================================================

# ===== DeepSeek 基础配置 =====
DEEPSEEK_API_KEY=sk-bb4057bd5a4b4a22841b1848a6a9e700
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_MAX_TOKENS=20000
DEEPSEEK_TIMEOUT=180
# 是否保存思维链（Chain of Thought）到文件，1=保存，0=不保存
DEEPSEEK_SAVE_COT=0

# ===== DeepSeek 分段输出的 token 预算 =====
# 单只股票分析的输出预算
DEEPSEEK_STOCK_MAX_TOKENS=8000
DEEPSEEK_STOCK_MAX_TOKENS_RETRY=16000
# 最终汇总 JSON 的输出预算
DEEPSEEK_SUMMARY_MAX_TOKENS=4500
DEEPSEEK_SUMMARY_MAX_TOKENS_RETRY=10000

# ============================================================
# 小米 MiMo 配置
# ============================================================

# ===== MiMo 基础配置 =====
MIMO_API_KEY=sk-c9cxzrmdtdwvbci09d6ockxzkrjtgt3vh4slukzz017vr9a9
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2-flash
MIMO_MAX_TOKENS=4096
MIMO_TIMEOUT=120

# ===== MiMo 分段输出的 token 预算 =====
# 注意：MiMo 的 token 预算可能需要根据实际情况调整
# mimo-v2-flash 的 max_completion_tokens 上限请参考官方文档
MIMO_STOCK_MAX_TOKENS=8000
MIMO_STOCK_MAX_TOKENS_RETRY=20000
MIMO_SUMMARY_MAX_TOKENS=5000
MIMO_SUMMARY_MAX_TOKENS_RETRY=15000

# ============================================================
# 网络配置
# ============================================================

# 自动禁用系统代理（避免代理问题）
DISABLE_PROXY=1
# 如果需要使用代理，取消下面注释并设置
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ============================================================
# 新闻抓取与 QC 清洗配置
# ============================================================

# 是否启用新闻质量控制（强烈建议开启）
NEWS_QC_ENABLE=1
# 新闻最大天数（超过此天数的新闻将被过滤）
NEWS_MAX_AGE_DAYS=7
# 标题最小长度
NEWS_MIN_TITLE_LEN=6
# 是否过滤乱码
NEWS_DROP_GARBLED=1
# 标题黑名单（正则，匹配到的新闻将被过滤）
NEWS_TITLE_BLACKLIST=友情链接|联系我们|关于我们|免责声明|隐私|法律声明|内容合作|运营许可|站点地图|客服|广告服务|投稿|APP下载
# 是否备份原始新闻到 _raw 目录
NEWS_QC_BACKUP_RAW=1

# ============================================================
# 回测配置（可选）
# ============================================================

# 默认使用 v2 版本（带仓位控制）
BACKTEST_VERSION=v2
# 最大总仓位（%）
BACKTEST_MAX_POSITION_PCT=30
# 单只股票最大仓位（%）
BACKTEST_SINGLE_STOCK_MAX_PCT=15
# 是否启用月线多头过滤
BACKTEST_USE_MONTHLY_TREND=1
# 是否根据市场情绪调整仓位
BACKTEST_USE_MARKET_REGIME=1

# ============================================================
# 数据源配置
# ============================================================

# BaoStock 不需要 API Key
# 如果使用 Tushare，需要配置
# TUSHARE_TOKEN=your-tushare-token

# ============================================================
# 输出配置
# ============================================================

# 报告输出目录（相对于项目根目录）
OUTPUT_DIR=out
# 是否生成 HTML 格式报告
GENERATE_HTML_REPORT=1
# 是否生成带大盘对比的图表
GENERATE_BENCHMARK_CHART=1